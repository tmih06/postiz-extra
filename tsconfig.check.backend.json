{
  "extends": "./apps/backend/tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "strict": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx"
  },
  "include": [
    "apps/backend/**/*",
    "apps/orchestrator/**/*",
    "apps/commands/**/*",
    "apps/sdk/**/*",
    "libraries/nestjs-libraries/src/**/*",
    "libraries/helpers/src/**/*"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/build/**",
    "**/out/**",
    "**/coverage/**"
  ]
}
