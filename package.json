  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "libraries/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n \"ext,orch,back,front\" \"bun run dev:extension\" \"bun run dev:orchestrator\" \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev-backend": "concurrently --kill-others-on-fail -n \"back,front\" \"bun run dev:backend\" \"bun run dev:frontend\"",
    "pm2": "bun run pm2-run",
    "publish-sdk": "bun run --cwd apps/sdk publish",
    "pm2-run": "bun run prisma-db-push && pm2-runtime start ecosystem.config.cjs",
    "dev:stripe": "concurrently \"stripe listen --forward-to localhost:3000/stripe\" \"bun run dev\"",
    "build": "bun run build:backend && bun run build:orchestrator && bun run build:frontend && bun run build:extension && bun run build:sdk && bun run build:commands",
    "build:backend": "rm -rf apps/backend/dist && bun run --cwd apps/backend build",
    "build:frontend": "rm -rf apps/frontend/dist && bun run --cwd apps/frontend build",
    "build:orchestrator": "rm -rf apps/orchestrator/dist && bun run --cwd apps/orchestrator build",
    "build:extension": "rm -rf apps/extension/dist && bun run --cwd apps/extension build",
    "dev:extension": "bun run --cwd apps/extension dev",
    "dev:backend": "bun run --cwd apps/backend dev",
    "dev:frontend": "bun run --cwd apps/frontend dev",
    "dev:frontend:legacy": "bun run --cwd apps/frontend dev:legacy",
    "build:frontend:legacy": "bun run --cwd apps/frontend build:legacy",
    "dev:orchestrator": "bun run --cwd apps/orchestrator dev",
    "start:prod:orchestrator": "bun run --cwd apps/orchestrator start",
    "start:prod:backend": "bun run --cwd apps/backend start",
    "start:prod:frontend": "bun run --cwd apps/frontend start",
    "dev:docker": "docker compose -f ./docker-compose.dev.yaml up -d",
    "commands:build:development": "bun run --cwd apps/commands build",
    "prisma-generate": "bun x prisma@6.5.0 generate --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-db-push": "bun x prisma@6.5.0 db push --accept-data-loss --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-db-pull": "bun x prisma@6.5.0 db pull --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-reset": "cd ./libraries/nestjs-libraries/src/database/prisma && bun x prisma@6.5.0 db push --force-reset && bun x prisma@6.5.0 db push",
    "docker-build": "./var/docker/docker-build.sh",
    "docker-create": "./var/docker/docker-create.sh",
    "postinstall": "bun run prisma-generate",
    "test": "vitest run --passWithNoTests",
    "build:sdk": "bun run --cwd apps/sdk build",
    "build:commands": "rm -rf apps/commands/dist && bun run --cwd apps/commands build"
  },
